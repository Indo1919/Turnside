# Optional. Leave blank for a credit-free, fully interactive demo.
# Keep this private server key out of VITE_* variables and source control.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# With no key the UI opens in Demo. Adding a Gemini key enables live conversation by default.
# Settings can switch itinerary planning back to the credit-free sample catalog.
# Set live only when you explicitly want all unflagged requests to use Gemini.
AI_MODE=demo

# Optional public pk.* token for Mapbox maps and real walking routes.
# With no token, the app uses OpenStreetMap and a dashed route preview.
MAPBOX_ACCESS_TOKEN=

PORT=4173
HOST=127.0.0.1

# User-initiated voice uses Gemini credits even when itinerary mode is Demo.
# Input: gemini-3.8-flash. Output: gemini-3.8-flash-tts (official Interactions API).
GEMINI_VOICE_ENABLED=true
GEMINI_LIVE_ENABLED=true
GEMINI_TTS_VOICE=Kore

# Intentionally browser-visible Google Maps JavaScript API key.
# Restrict it by HTTP referrer/app origin and permitted browser APIs in Google Cloud.
GOOGLE_MAPS_BROWSER_KEY=

# Private server-only keys. These are never returned in /api/config.
GOOGLE_PLACES_API_KEY=
# Teammate-compatible private key alias for Places API (New) and Routes API.
# Enable both APIs and restrict this key to your server APIs/IP.
GOOGLE_MAPS_SERVER_KEY=
# Optional separate private Routes key.
GOOGLE_ROUTES_API_KEY=
# Legacy/private Maps key slot; does not automatically enable browser maps.
GOOGLE_MAPS_API_KEY=
